# Copy this file to .env and fill in real values. .env is gitignored; this
# example file is committed so the required variables are documented.
#
# Each account uses one of two transports:
#
#   smtp  (default) — sends directly through Gmail with an App Password.
#                     Works locally and on a VPS. Does NOT work on hosts that
#                     block outbound SMTP (Render's free tier blocks all ports).
#
#   brevo           — sends over Brevo's HTTPS API, so it works anywhere,
#                     including Render. Send from an address on a domain you've
#                     verified in Brevo (SPF/DKIM), not from an @gmail.com
#                     address — third-party sending as @gmail.com fails DMARC
#                     and lands in spam.

# --- SMTP example (local / VPS) ---
MAIL_ACCOUNT_1_LABEL=Recruiting
MAIL_ACCOUNT_1_EMAIL=recruiting@example.com
MAIL_ACCOUNT_1_TRANSPORT=smtp
MAIL_ACCOUNT_1_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_ACCOUNT_1_DAILY_CAP=450

# --- Brevo example (works on Render) ---
MAIL_ACCOUNT_2_LABEL=Recruiting
MAIL_ACCOUNT_2_EMAIL=recruitment@yourdomain.com
MAIL_ACCOUNT_2_TRANSPORT=brevo
MAIL_ACCOUNT_2_API_KEY=xkeysib-...
MAIL_ACCOUNT_2_DAILY_CAP=300

# PORT=5000
# Default cap applied when an account doesn't set its own:
# SEND_DAILY_CAP=450
