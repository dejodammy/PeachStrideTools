# Copy this file to .env and fill in real values. .env is gitignored; this
# example file is committed so the required variables are documented.
#
# Each account uses one of two transports:
#
#   smtp  (default) — sends directly through Gmail with an App Password.
#                     Works locally and on a VPS. Does NOT work on hosts that
#                     block outbound SMTP (Render's free tier blocks all ports).
#
#   brevo           — sends over Brevo's HTTPS API, so it works anywhere,
#                     including Render. Send from an address on a domain you've
#                     verified in Brevo (SPF/DKIM), not from an @gmail.com
#                     address — third-party sending as @gmail.com fails DMARC
#                     and lands in spam.

# --- SMTP example (local / VPS) ---
MAIL_ACCOUNT_1_LABEL=Recruiting
MAIL_ACCOUNT_1_EMAIL=recruiting@example.com
MAIL_ACCOUNT_1_TRANSPORT=smtp
MAIL_ACCOUNT_1_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_ACCOUNT_1_DAILY_CAP=450

# --- Brevo example (works on Render) ---
MAIL_ACCOUNT_2_LABEL=Recruiting
MAIL_ACCOUNT_2_EMAIL=recruitment@yourdomain.com
MAIL_ACCOUNT_2_TRANSPORT=brevo
MAIL_ACCOUNT_2_API_KEY=xkeysib-...
MAIL_ACCOUNT_2_DAILY_CAP=300

# PORT=5000
# Default cap applied when an account doesn't set its own:
# SEND_DAILY_CAP=450

# --- Google sign-in (required — without these the app is completely locked) ---
#
# Every route that touches campaign data or sends mail requires a signed-in
# session. Sign-in is "Sign in with Google", restricted to the exact emails
# listed in ALLOWED_EMAILS below — anyone else's Google account is rejected
# even though the sign-in button itself is public.
#
# One-time setup in Google Cloud Console (https://console.cloud.google.com):
#
#   1. Create a project (or reuse one) — top-left project picker → New Project.
#   2. APIs & Services → OAuth consent screen
#        - User type: External
#        - App name: anything (e.g. "Peach Strides Tools")
#        - Scopes: none needed beyond the default (openid, email, profile)
#        - Test users: add every staff Gmail address that should have access.
#          Leaving the app in "Testing" mode (don't publish) means ONLY the
#          test users you list can sign in, and they see no scary "unverified
#          app" warning — this is the correct, permanent state for an
#          internal tool. No Google review needed.
#   3. APIs & Services → Credentials → Create Credentials → OAuth client ID
#        - Application type: Web application
#        - Authorized redirect URI: must match GOOGLE_REDIRECT_URI below
#          EXACTLY (same scheme, host, and path) — e.g.
#          https://mailer.peachstridesandpristine.com/auth/google/callback
#   4. Copy the generated Client ID and Client Secret into the two variables
#      below.
#
# SESSION_SECRET signs the login cookie — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret. Changing it logs everyone out (all existing sessions become
# invalid — that's also how you'd force a full logout if needed).
#
# ALLOWED_EMAILS is the real access control: a comma-separated allowlist.
# Must exactly match the Google account each person signs in with. Adding a
# new person here (without also adding them as a consent-screen test user)
# will still fail — both lists need to include them.
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
SESSION_SECRET=generate-a-random-64-char-hex-string-see-above
ALLOWED_EMAILS=staff1@gmail.com,staff2@gmail.com,staff3@gmail.com
