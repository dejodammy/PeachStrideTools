<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      html, body { margin: 0; padding: 0; }
      .card { position: relative; width: 591px; height: 1004px; background: url("{{FrameDataUri}}") no-repeat; background-size: 591px 1004px; font-family: Arial, Helvetica, sans-serif; }
      .photo { position: absolute; left: 67px; top: 199px; width: 466px; height: 485px; overflow: hidden; background: #f5f5f5; display: flex; align-items: center; justify-content: center; }
      .photo img { width: 100%; height: 100%; object-fit: cover; }
      .photo .placeholder { color: #bbb; font-size: 160px; font-weight: 700; }
      .name { position: absolute; left: 25px; top: 724px; width: 541px; height: 48px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 32px; font-weight: 800; color: #080808; text-transform: uppercase; white-space: nowrap; }
      .role { position: absolute; left: 25px; top: 782px; width: 541px; height: 39px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 28px; font-weight: 400; letter-spacing: 4px; color: #de2728; text-transform: uppercase; }
      .signature { position: absolute; left: 105px; top: 832px; width: 381px; height: 108px; display: flex; align-items: center; justify-content: center; }
      .signature img { width: 100%; height: 100%; object-fit: contain; }
      .signature .line { width: 100%; border-top: 1px solid #555; padding-top: 5px; text-align: center; color: #777; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="photo">
        {{#if PhotoDataUri}}<img src="{{PhotoDataUri}}" style="object-position: {{PhotoFocusX}}% {{PhotoFocusY}}%;" />{{else}}<div class="placeholder">?</div>{{/if}}
      </div>
      <div class="name">{{Name}}</div>
      <div class="role">{{Role}}</div>
      <div class="signature">{{#if SignatureDataUri}}<img src="{{SignatureDataUri}}" />{{else}}<div class="line">Signature</div>{{/if}}</div>
    </div>
    <script>
      // Long names stay on one line: shrink the text until it fits the card.
      (function () {
        var el = document.querySelector(".name");
        var size = 32;
        while (el.scrollWidth > el.clientWidth && size > 16) {
          size -= 1;
          el.style.fontSize = size + "px";
        }
      })();
    </script>
  </body>
</html>
