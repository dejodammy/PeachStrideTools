# Dependencies
node_modules/

# Build output
client/dist/

# Runtime campaign data (recipient lists, generated PDFs, send logs — not source)
server/data/campaigns/*
!server/data/campaigns/.gitkeep

# Logs
*.log
npm-debug.log*

# Local env files (never commit SMTP credentials)
.env
.env.local

# Personal test/demo spreadsheet (contains a real email address)
demo_recipients.xlsx

# OS/editor cruft
.DS_Store
Thumbs.db

# Runtime CV extraction jobs (uploaded CVs + generated spreadsheets)
server/data/extractions/*
!server/data/extractions/.gitkeep
