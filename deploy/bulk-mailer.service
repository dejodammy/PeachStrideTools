[Unit]
Description=Bulk Mailer (PeachStrideTools)
After=network.target

[Service]
Type=simple
User=app
# dotenv reads .env relative to the working directory, so this must be server/
WorkingDirectory=/home/app/PeachStrideTools/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Basic hardening — the app only ever needs to write inside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/app/PeachStrideTools/server/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bulk-mailer

[Install]
WantedBy=multi-user.target
